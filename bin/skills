#!/usr/bin/env bash
# skills - install this agent skills library for every AI coding agent on the machine.
#
#   skills install          set up the global layer   (Claude Code, Codex, Gemini CLI)
#   skills init [dir]       set up a repo             (Cursor, Copilot, Cline, Windsurf, ...)
#   skills doctor           show what is installed where
#   skills update           refresh the library, then re-run install
#   skills list             list the skills
#   skills uninstall        remove what install/init wrote
#
# Flags:  --link (default for install)  --copy  --dry-run  --force  --no-exclude
#         NO_HOOK=1  NO_EXCLUDE=1
set -euo pipefail

# Resolve through the PATH symlink so LIB points at the clone, not ~/.local/bin.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  _t="$(readlink "$SELF")"
  case "$_t" in /*) SELF="$_t" ;; *) SELF="$(dirname "$SELF")/$_t" ;; esac
done
LIB="$(cd "$(dirname "$SELF")/.." && pwd)"
SRC="$LIB/skills"
HOME_DIR="${SKILLS_DIR:-$HOME/.agent-skills}"
DRY=0; FORCE=0; MODE=link; NO_EXCLUDE="${NO_EXCLUDE:-0}"
EXCLUDE_MARKER="# agent config written by 'skills init', personal to this clone"

say()  { printf '  %s\n' "$*"; }
ok()   { printf '  \033[32m+\033[0m %s\n' "$*"; }
same() { printf '  \033[2m=\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
run()  { [ "$DRY" = 1 ] && { printf '  \033[2m# %s\033[0m\n' "$*"; return 0; }; eval "$@"; }

# place SRC DEST LABEL HINT - never clobbers a file that differs
place() {
  local src="$1" dst="$2" label="$3" hint="${4:-}"
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then same "$label"; return; fi
  # Agents touch an empty config file on first run. There is nothing in it to keep, so
  # overwrite it rather than parking a .from-skills-library nobody reads.
  if [ -e "$dst" ] && [ ! -L "$dst" ] && [ ! -s "$dst" ]; then run "rm -f '$dst'"; fi
  if [ -e "$dst" ]; then
    if cmp -s "$src" "$dst" 2>/dev/null; then same "$label"; return; fi
    if [ "$FORCE" = 1 ]; then run "rm -f '$dst'"
    else
      run "cp '$src' '$dst.from-skills-library'"
      warn "$label exists and differs. Wrote $(basename "$dst").from-skills-library"
      [ -n "$hint" ] && say "    $hint"
      return
    fi
  fi
  run "mkdir -p '$(dirname "$dst")'"
  if [ "$MODE" = link ]; then run "ln -sf '$src' '$dst'"; else run "cp '$src' '$dst'"; fi
  ok "$label"
}

# relink DEST_DIR - symlink every skill into DEST_DIR
relink_skills() {
  local dest="$1" n=0
  run "mkdir -p '$dest'"
  for d in "$SRC"/*/; do
    [ -f "$d/SKILL.md" ] || continue
    local name; name=$(basename "$d")
    run "rm -rf '$dest/$name'"
    if [ "$MODE" = link ]; then run "ln -s '${d%/}' '$dest/$name'"; else run "cp -R '$d' '$dest/$name'"; fi
    n=$((n+1))
  done
  ok "$n skills -> $dest$([ "$MODE" = link ] && echo ' (symlinked)')"
}

# import_line FILE IMPORT LABEL - append an @import if not already present
import_line() {
  local file="$1" line="$2" label="$3"
  if [ -f "$file" ] && grep -qF "$line" "$file"; then same "$label"; return; fi
  if [ -f "$file" ]; then
    run "printf '\n%s\n' '$line' >> '$file'"
    ok "$label (appended import)"
  else
    run "mkdir -p '$(dirname "$file")'"
    run "printf '%s\n' '$line' > '$file'"
    ok "$label"
  fi
}

cmd_install() {
  echo "Global layer, applies to every repo on this machine."
  echo
  # Claude Code executes the hook directly, so it needs the bit even if git lost it.
  chmod +x "$LIB"/hooks/*.sh 2>/dev/null || true

  echo "Claude Code"
  relink_skills "$HOME/.claude/skills"
  import_line "$HOME/.claude/CLAUDE.md" "@$LIB/AGENTS.md" "~/.claude/CLAUDE.md"
  if [ "${NO_HOOK:-0}" != 1 ]; then
    if command -v python3 >/dev/null 2>&1; then
      [ "$DRY" = 1 ] && say "# register UserPromptSubmit hook" || python3 - "$HOME/.claude/settings.json" "$LIB/hooks/inject-rules.sh" <<'PY'
import json, os, sys
p, cmd = sys.argv[1], sys.argv[2]
try: cfg = json.load(open(p)) if os.path.exists(p) and os.path.getsize(p) else {}
except json.JSONDecodeError: print(f"  \033[33m!\033[0m {p} is not valid JSON, hook not registered"); sys.exit(0)
ups = cfg.setdefault("hooks", {}).setdefault("UserPromptSubmit", [])
if any(cmd in json.dumps(e) for e in ups): print("  \033[2m=\033[0m per-turn hook")
else:
    ups.append({"hooks": [{"type": "command", "command": cmd}]})
    os.makedirs(os.path.dirname(p), exist_ok=True)
    json.dump(cfg, open(p, "w"), indent=2); open(p, "a").write("\n")
    print("  \033[32m+\033[0m per-turn hook -> ~/.claude/settings.json")
PY
    else warn "python3 not found, hook not registered"; fi
  fi
  echo

  echo "Codex"
  # Same layout and frontmatter as Claude Code: ~/.codex/skills/<name>/SKILL.md.
  # Codex's own bundled skills sit under .system/, which relink_skills never touches.
  relink_skills "$HOME/.codex/skills"
  place "$LIB/AGENTS.md" "$HOME/.codex/AGENTS.md" "~/.codex/AGENTS.md" \
        "merge the library's AGENTS.md into yours"
  echo

  echo "Gemini CLI"
  import_line "$HOME/.gemini/GEMINI.md" "@$LIB/AGENTS.md" "~/.gemini/GEMINI.md"
  echo

  echo "Per-repo agents (Cursor, Copilot, Cline, Windsurf, Aider, Zed):"
  say "these read a file from the repo root, not from \$HOME. In each repo run:"
  say "    skills init"
  echo
  link_launcher
}

# `skills init` is the next thing every install tells the user to run, so install has
# to leave a launcher they can actually type. bootstrap.sh and the npm handoff each
# link one, but `bash bin/skills install` straight from a clone linked nothing.
link_launcher() {
  local bin_dir="${SKILLS_BIN:-$HOME/.local/bin}"
  local dst="$bin_dir/skills"
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$LIB/bin/skills" ]; then
    same "launcher  ($dst)"
  else
    run "mkdir -p '$bin_dir'"
    run "ln -sf '$LIB/bin/skills' '$dst'"
    ok "launcher -> $dst"
  fi
  check_on_path
}

# Whether `skills` will resolve in the user's next shell, which is not the same
# question as whether it resolves right now: npx prepends a cache directory that is
# deleted when the command ends, so a hit there is a launcher that will not exist.
check_on_path() {
  local bin_dir="${SKILLS_BIN:-$HOME/.local/bin}"
  case ":$PATH:" in *":$bin_dir:"*) same "$bin_dir is on your PATH"; return ;; esac
  local found; found="$(command -v skills 2>/dev/null || true)"
  case "$found" in */_npx/*|*/node_modules/.bin/*) found="" ;; esac
  if [ -n "$found" ]; then same "skills resolves to $found"; return; fi
  warn "$bin_dir is not on your PATH, so 'skills init' will not resolve yet:"
  say "    echo 'export PATH=\"$bin_dir:\$PATH\"' >> ~/.zshrc && exec zsh"
  say "    bash, not zsh? use ~/.bashrc and 'exec bash'"
}

# exclude_from_git REPO - keep the files init writes out of `git status`.
#
# .git/info/exclude is local to one clone and is never committed, so a teammate who
# clones the repo sees none of this. A file already tracked is left alone: exclude has
# no effect on anything in the index, and listing it would imply an effect it cannot
# have. Nothing here is written twice, so re-running init is a no-op.
exclude_from_git() {
  local repo="$1"
  if [ "$NO_EXCLUDE" = 1 ]; then say "left in git status (--no-exclude)"; return 0; fi
  command -v git >/dev/null 2>&1 || return 0

  # --git-common-dir, not --git-dir: a linked worktree shares the main repo's exclude.
  local common
  if ! common=$(git -C "$repo" rev-parse --git-common-dir 2>/dev/null); then
    say "not a git repo yet, so nothing to exclude. Re-run init after git init."
    return 0
  fi
  case "$common" in /*) ;; *) common="$repo/$common" ;; esac
  local exclude="$common/info/exclude"

  local f pending="" tracked="" n=0
  for f in AGENTS.md CLAUDE.md GEMINI.md CONVENTIONS.md .clinerules .windsurfrules \
           .github/copilot-instructions.md '*.from-skills-library'; do
    case "$f" in
      \**) ;;                      # a glob for the backup copies, nothing to stat
      *)
        # On a dry run the files do not exist yet, but a real run would have made them.
        if [ "$DRY" != 1 ] && [ ! -e "$repo/$f" ]; then continue; fi
        if git -C "$repo" ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
          tracked="$tracked $f"; continue
        fi ;;
    esac
    grep -qxF "$f" "$exclude" 2>/dev/null && continue
    pending="$pending$f
"
    n=$((n+1))
  done

  if [ -z "$pending" ]; then
    same ".git/info/exclude  (already listed)"
  elif [ "$DRY" = 1 ]; then
    printf '  \033[2m# append %s path(s) to %s\033[0m\n' "$n" "$exclude"
  else
    mkdir -p "$(dirname "$exclude")"
    # A file not ending in a newline would otherwise swallow the first path onto its last line.
    if [ -s "$exclude" ] && [ -n "$(tail -c1 "$exclude")" ]; then printf '\n' >> "$exclude"; fi
    grep -qxF "$EXCLUDE_MARKER" "$exclude" 2>/dev/null || printf '%s\n' "$EXCLUDE_MARKER" >> "$exclude"
    printf '%s' "$pending" >> "$exclude"
    ok ".git/info/exclude  ($n path(s), this clone only)"
  fi
  if [ -n "$tracked" ]; then say "tracked already, left visible:$tracked"; fi
}

# Where the checksum of the AGENTS.md init last wrote is kept. Beside .git/info/exclude
# for the same reason: local to one clone, never committed, invisible to a teammate.
init_stamp() {
  local common
  common=$(git -C "$1" rev-parse --git-common-dir 2>/dev/null) || return 1
  case "$common" in /*) ;; *) common="$1/$common" ;; esac
  printf '%s' "$common/info/skills-init.sha"
}

sha_of() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  fi
}

cmd_init() {
  local repo="${1:-$PWD}"
  [ -d "$repo" ] || { echo "no such directory: $repo" >&2; exit 1; }
  repo="$(cd "$repo" && pwd)"
  echo "Repo layer -> $repo"
  echo

  # A copy init wrote that nobody has since edited is safe to refresh. Without this,
  # place() cannot tell its own stale output from something the user wrote, so every
  # repo set up before a library update stays on the old rules for good.
  local stamp; stamp="$(init_stamp "$repo" || true)"
  if [ -n "$stamp" ] && [ -f "$stamp" ] && [ -f "$repo/AGENTS.md" ] \
     && [ "$(sha_of "$repo/AGENTS.md")" = "$(cat "$stamp")" ] \
     && ! cmp -s "$LIB/AGENTS.md" "$repo/AGENTS.md"; then
    run "rm -f '$repo/AGENTS.md'"
    say "AGENTS.md was unedited since init wrote it, so refreshing it"
  fi

  # AGENTS.md is the canonical file; every other agent points at it.
  local MODE_SAVED=$MODE; MODE=copy
  place "$LIB/AGENTS.md" "$repo/AGENTS.md" "AGENTS.md  (Cursor, Codex, Windsurf, Aider, Zed, Jules, Amp)" \
        "merge the library's AGENTS.md into yours, or re-run with --force to overwrite"
  MODE=$MODE_SAVED

  # Only stamp a file that matches the library, so a user edit is never recorded as ours.
  if [ -n "$stamp" ] && [ "$DRY" != 1 ] && cmp -s "$LIB/AGENTS.md" "$repo/AGENTS.md" 2>/dev/null; then
    mkdir -p "$(dirname "$stamp")" && sha_of "$repo/AGENTS.md" > "$stamp"
  fi

  # Claude Code reads CLAUDE.md only, so import AGENTS.md from it.
  if [ -f "$repo/CLAUDE.md" ]; then
    if grep -qF "@AGENTS.md" "$repo/CLAUDE.md"; then same "CLAUDE.md  (Claude Code)"
    else warn "CLAUDE.md exists. Add this line to it:"; say "    @AGENTS.md"; fi
  else
    run "printf '@AGENTS.md\n' > '$repo/CLAUDE.md'"
    ok "CLAUDE.md  (Claude Code)"
  fi

  # Agents that want their own filename: point them at AGENTS.md with a relative symlink.
  link_alias() {  # $1 = path relative to repo, $2 = relative target, $3 = label
    local dst="$repo/$1"
    if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$2" ]; then same "$1  ($3)"; return; fi
    if [ -e "$dst" ]; then warn "$1 exists, left alone  ($3)"; return; fi
    run "mkdir -p '$(dirname "$dst")'"
    run "ln -s '$2' '$dst'"
    ok "$1 -> $2  ($3)"
  }
  link_alias ".github/copilot-instructions.md" "../AGENTS.md" "GitHub Copilot"
  link_alias ".clinerules"                     "AGENTS.md"    "Cline"
  link_alias ".windsurfrules"                  "AGENTS.md"    "Windsurf"
  link_alias "GEMINI.md"                       "AGENTS.md"    "Gemini CLI"
  link_alias "CONVENTIONS.md"                  "AGENTS.md"    "Aider"
  echo
  exclude_from_git "$repo"
  echo
  say "Skills themselves are global. If you have not run 'skills install' yet, do that once."
}

cmd_doctor() {
  echo "Library:  $LIB"
  echo "Skills:   $(find "$SRC" -name SKILL.md | wc -l | tr -d ' ')"
  echo
  echo "Global"
  local dir n
  for dir in "$HOME/.claude/skills" "$HOME/.codex/skills"; do
    n=$(ls -1 "$dir" 2>/dev/null | wc -l | tr -d ' ')
    [ "$n" -gt 0 ] && ok "${dir/#$HOME/~}  ($n entries)" || warn "${dir/#$HOME/~}  empty"
  done
  for f in "$HOME/.claude/CLAUDE.md" "$HOME/.codex/AGENTS.md" "$HOME/.gemini/GEMINI.md"; do
    [ -e "$f" ] && ok "${f/#$HOME/~}" || warn "${f/#$HOME/~}  missing"
  done
  if [ -f "$HOME/.claude/settings.json" ] && grep -q inject-rules "$HOME/.claude/settings.json" 2>/dev/null
    then ok "per-turn hook registered"; else warn "per-turn hook not registered"; fi
  local launcher="${SKILLS_BIN:-$HOME/.local/bin}/skills"
  if [ -e "$launcher" ]; then ok "launcher -> $(readlink "$launcher" 2>/dev/null || echo "$launcher")"
  else warn "${launcher/#$HOME/~}  missing"; fi
  check_on_path
  echo
  echo "This repo ($PWD)"
  for f in AGENTS.md CLAUDE.md .github/copilot-instructions.md .clinerules .windsurfrules GEMINI.md CONVENTIONS.md; do
    [ -e "$f" ] && ok "$f" || warn "$f  missing"
  done
}

cmd_uninstall() {
  local dest name
  for dest in "$HOME/.claude/skills" "$HOME/.codex/skills"; do
    for d in "$SRC"/*/; do
      name=$(basename "$d")
      [ -e "$dest/$name" ] || [ -L "$dest/$name" ] || continue
      run "rm -rf '$dest/$name'"
    done
    ok "removed skills from ${dest/#$HOME/~}"
  done
  say "left alone: CLAUDE.md, AGENTS.md, GEMINI.md, settings.json, and repo files."
  say "the import lines and the hook entry need removing by hand."
}

# npm delivers the library but is not a home for it. npx wipes its cache directory,
# and nvm's global prefix carries the node version in its path, so every symlink and
# every absolute @import pointing into an npm directory rots the moment either moves.
# Copy the payload to $HOME_DIR once and run everything from there.
from_npm() {
  [ -d "$LIB/.git" ] && return 1
  [ -f "$LIB/package.json" ] || return 1
  case "$LIB" in */node_modules/*|*/_npx/*) return 0 ;; *) return 1 ;; esac
}

rollback_materialization() {
  local destination="$1" staging="$2" previous="$3"
  local item target saved restore_failed=0
  trap - HUP INT TERM
  while IFS= read -r item; do
    target="$destination/$item"
    saved="$previous/$item"
    if [ -e "$saved" ] || [ -L "$saved" ]; then
      rm -rf "$target"
      mkdir -p "$(dirname "$target")"
      if ! mv "$saved" "$target"; then
        warn "could not restore $target, the previous copy remains at $saved"
        restore_failed=1
      fi
    elif { [ ! -e "$staging/$item" ] && [ ! -L "$staging/$item" ]; }; then
      rm -rf "$target"
    fi
  done < "$staging/.materialize-payload"
  rm -rf "$staging"
  if [ "$restore_failed" = 0 ]; then rm -rf "$previous"; fi
  exit 1
}

materialize() {
  if [ -e "$HOME_DIR/.git" ]; then
    say "using the git clone already at $HOME_DIR (npm copy ignored)"
    return
  fi
  say "copying the library to $HOME_DIR"
  [ "$DRY" = 1 ] && return
  local parent name staging previous f item
  local payload=(skills hooks bin/skills .installed-by-npm)
  parent=$(dirname "$HOME_DIR")
  name=$(basename "$HOME_DIR")
  mkdir -p "$parent"
  staging=$(mktemp -d "$parent/.${name}.new.XXXXXX")

  mkdir -p "$staging/bin" || { rm -rf "$staging"; return 1; }
  cp -R "$LIB/skills" "$LIB/hooks" "$staging/" || { rm -rf "$staging"; return 1; }
  cp "$LIB/bin/skills" "$staging/bin/skills" || { rm -rf "$staging"; return 1; }
  for f in AGENTS.md CLAUDE.md README.md install.sh validate.sh bootstrap.sh package.json; do
    if [ -f "$LIB/$f" ]; then
      cp "$LIB/$f" "$staging/$f" || { rm -rf "$staging"; return 1; }
      payload+=("$f")
    fi
  done
  chmod +x "$staging/bin/skills" "$staging"/*.sh "$staging"/hooks/*.sh 2>/dev/null || true
  # Marker: `skills update` cannot git pull a copy, it has to go back through npm.
  printf '%s\n' "$LIB" > "$staging/.installed-by-npm" || { rm -rf "$staging"; return 1; }
  printf '%s\n' "${payload[@]}" > "$staging/.materialize-payload" || {
    rm -rf "$staging"; return 1;
  }

  mkdir -p "$HOME_DIR" || { rm -rf "$staging"; return 1; }
  previous=$(mktemp -d "$parent/.${name}.old.XXXXXX") || { rm -rf "$staging"; return 1; }
  trap 'rollback_materialization "$HOME_DIR" "$staging" "$previous"' HUP INT TERM
  for item in "${payload[@]}"; do
    if [ -e "$HOME_DIR/$item" ] || [ -L "$HOME_DIR/$item" ]; then
      mkdir -p "$previous/$(dirname "$item")" || rollback_materialization "$HOME_DIR" "$staging" "$previous"
      mv "$HOME_DIR/$item" "$previous/$item" || rollback_materialization "$HOME_DIR" "$staging" "$previous"
    fi
    mkdir -p "$(dirname "$HOME_DIR/$item")" || rollback_materialization "$HOME_DIR" "$staging" "$previous"
    mv "$staging/$item" "$HOME_DIR/$item" || rollback_materialization "$HOME_DIR" "$staging" "$previous"
  done
  trap - HUP INT TERM
  rm -rf "$staging" "$previous"

  local bin_dir="${SKILLS_BIN:-$HOME/.local/bin}"
  mkdir -p "$bin_dir" && ln -sf "$HOME_DIR/bin/skills" "$bin_dir/skills"
}

SUB="${1:-}"; [ $# -gt 0 ] && shift || true
REST=("$@")
ARGS=()
for a in "$@"; do
  case "$a" in
    --dry-run) DRY=1 ;; --force) FORCE=1 ;; --copy) MODE=copy ;; --link) MODE=link ;;
    --no-exclude) NO_EXCLUDE=1 ;;
    *) ARGS+=("$a") ;;
  esac
done

if from_npm && [ "${SKILLS_NO_HANDOFF:-0}" != 1 ]; then
  case "$SUB" in
    install|update)
      materialize
      [ "$DRY" = 1 ] || exec env SKILLS_NO_HANDOFF=1 bash "$HOME_DIR/bin/skills" \
        install ${REST[@]+"${REST[@]}"}
      ;;
  esac
fi

case "$SUB" in
  install)   cmd_install ;;
  init)      cmd_init "${ARGS[0]:-$PWD}" ;;
  doctor)    cmd_doctor ;;
  list)      "$LIB/install.sh" --list ;;
  update)
    if [ -d "$LIB/.git" ]; then
      git -C "$LIB" pull --ff-only && MODE=link cmd_install
    elif [ -f "$LIB/.installed-by-npm" ]; then
      warn "installed from npm, so there is nothing to git pull. Re-run the installer:"
      say "    npx github:Mehul72/skills install"
      say "    npm 12 and later gate git sources: add --allow-git=root"
      exit 1
    else
      warn "$LIB is not a git clone. Reinstall it to update."
      exit 1
    fi ;;
  uninstall) cmd_uninstall ;;
  ""|-h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "unknown command: $SUB" >&2; exit 1 ;;
esac
